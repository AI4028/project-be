# Database. SQLite locally. Production uses Postgres:
# postgresql+psycopg://user:password@host:5432/galjido
DATABASE_URL=sqlite:///./galjido.db
# Browser origins allowed to call the API, comma-separated. * = any.
CORS_ORIGINS=*
# Optional folder with a built web frontend, served at /app.
FRONTEND_DIR=
# Demo pairing shortcuts. 1 = on. Never on a real deployment.
DEMO_MODE=0
# Server-only Kakao Local REST key. Station/public-data search works without it.
KAKAO_REST_API_KEY=
# Private S3 bucket for menu photos. With no bucket, sample photos are served locally.
MENU_PHOTO_BUCKET=
AWS_DEFAULT_REGION=ap-southeast-2

# Server-only TMAP pedestrian routing for Find nearby
TMAP_APP_KEY=
