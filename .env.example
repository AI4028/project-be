# Database URL. Default is a local SQLite file.
DATABASE_URL=sqlite:///./galjido.db
# Browser origins allowed to call the API, comma-separated. * = any.
CORS_ORIGINS=*
# Optional folder with a built web frontend, served at /app.
FRONTEND_DIR=
# Demo pairing shortcuts. 1 = on. Never on a real deployment.
DEMO_MODE=0
